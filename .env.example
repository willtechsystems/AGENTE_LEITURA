# Chave da API da OpenAI (opcional para rodar com dataset local e fallback de áudio)
OPENAI_API_KEY=

# Modelo de síntese de voz (recomendado: gpt-4o-mini-tts ou tts-1)
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Voz da OpenAI (ex.: coral, alloy, nova, shimmer, sage, onyx)
OPENAI_TTS_VOICE=coral

# Modelo de texto para geração de novas palavras estruturadas
OPENAI_CHAT_MODEL=gpt-4o-mini

# Porta e host do servidor local (use 0.0.0.0 para acessar pelo celular na mesma rede Wi-Fi)
PORT=3000
HOST=0.0.0.0
